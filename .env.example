# GitHub 공개 저장소를 읽을 사용자명입니다.
GITHUB_USERNAME=your-github-username

# 사이트에 표시할 제작자 이름입니다.
SITE_OWNER=이정주

# 연락용 이메일입니다. 비밀번호나 토큰을 넣지 마세요.
CONTACT_EMAIL=your-email@example.com

# GitHub Pages에 배포할 저장소 이름입니다.
SITE_REPOSITORY=web-constellation

# 배포될 최종 주소입니다. 커스텀 도메인이 없으면 GitHub Pages 주소를 사용합니다.
SITE_URL=https://your-github-username.github.io/web-constellation/

# 커스텀 도메인이 있을 때만 입력합니다. 예: constellation.example.com
CUSTOM_DOMAIN=

# 선택 사항: 로컬 동기화 요청 한도를 늘릴 때만 .env.local에 넣으세요.
# 이 값을 VITE_GITHUB_TOKEN처럼 VITE_ 접두사로 만들면 브라우저에 노출될 수 있습니다.
GITHUB_TOKEN=

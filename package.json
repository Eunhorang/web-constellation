{
  "name": "web-constellation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "sync": "node --env-file-if-exists=.env.local scripts/sync-github.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:seo": "node --env-file-if-exists=.env.local scripts/generate-seo.mjs",
    "prebuild": "node scripts/prepare-build.mjs",
    "build": "vite build",
    "check:build": "node scripts/check-build-security.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
